generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  name               String?
  avatarUrl          String?
  passwordHash       String
  /// Cuándo se cambió el password por última vez (null = nunca cambiado, usa createdAt como proxy).
  /// Se setea al hashear un password nuevo en /api/account/password.
  passwordChangedAt  DateTime?
  role               String         @default("agency")
  emailNotifications Boolean        @default(true)
  /// Timezone IANA (ej. "America/Bogota"). Usado para formatear fechas en
  /// emails y en la UI cuando importa la zona horaria del user.
  timezone           String?
  /// Idioma preferido (ISO 639-1: "es", "en"). Default null → resuelve a
  /// "es" desde la app. Affecta UI strings + emails.
  locale             String?
  /// Soft-disable: si está seteado, el user no puede loguearse y se invalidan
  /// todas sus sesiones. Mantenemos la row para auditoría — distinto de borrar.
  /// Los handlers de auth chequean esto al crear/validar sesión.
  disabledAt         DateTime?
  /// Razón del disable (opcional, visible solo a admins). Ej. "fraud", "TOS".
  disabledReason     String?
  /// Two-factor auth (TOTP). Si totpSecret está seteado, el login requiere
  /// código de 6 dígitos. recoveryCodesHash es JSON array de hashes bcrypt
  /// para los códigos one-time de recuperación.
  totpSecret         String?
  totpEnabledAt      DateTime?
  recoveryCodesHash  Json?
  /// Onboarding wizard: cuando el user completa el flujo guiado
  /// post-signup. null = no completó / saltó. Sirve para no volver a
  /// mostrar el wizard a users existentes y para tracking.
  onboardingCompletedAt DateTime?
  createdAt          DateTime       @default(now())
  memberships   Membership[]
  comments      Comment[] @relation("CommentAuthor")
  assignedComments Comment[] @relation("CommentAssignee")
  approvals     Approval[]
  sessions      Session[]
  notifications Notification[]
  activities    Activity[]
  /// Legacy: asignee único. Deprecated en favor de `tasksAssignedMulti` que
  /// soporta múltiples assignees por tarea. La columna se mantiene en DB
  /// hasta un cleanup futuro — todo el código nuevo usa la M2M.
  tasksAssigned       Task[] @relation("TaskAssignee")
  /// NUEVO: source of truth de asignaciones (1 o más users por task).
  tasksAssignedMulti  Task[] @relation("TaskAssignees")
  tasksCreated        Task[] @relation("TaskCreator")
  taskComments        TaskComment[]  @relation("TaskCommentAuthor")
  taskActivities      TaskActivity[] @relation("TaskActivityActor")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  body      String
  /// Agencia (workspace) a la que pertenece la notificación. Denormalizado al
  /// crearla (desde la brand o la tarea de origen) — igual que actorName. Es
  /// lo que separa el inbox/campana entre espacios de trabajo. NULL = global
  /// (sin contexto de agencia; se muestra en cualquier workspace).
  agencyId  String?
  brandId   String?
  postId    String?
  /// Tarea relacionada (notifs task_assigned / task_mention / task_due_*).
  /// Permite linkear la notificación a /tasks?open=<taskId>. NULL para notifs
  /// de posts. No es FK con cascade a propósito: si la tarea se borra, la
  /// notificación histórica queda (el link simplemente no abrirá nada).
  taskId    String?
  actorName String?
  /// Foto de perfil de quien gatilló la notificación (denormalizado, igual
  /// que actorName) para mostrar el avatar real en el inbox/campana. Null →
  /// se muestra la inicial.
  actorAvatarUrl String?
  read      Boolean  @default(false)
  /// Si está seteado, la notificación se considera "snoozed" hasta esa
  /// fecha — UI la oculta del feed principal pero NO la elimina.
  snoozedUntil DateTime?
  /// Archivada: el user la cerró/escondió pero no quiere borrarla.
  archivedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([userId, archivedAt, snoozedUntil])
  // Inbox/campana scopeado por workspace + badge de no-leídas por agencia.
  @@index([userId, agencyId, read])
  // Dedup batch del cron de reminders (taskId IN (...) + type + createdAt)
  // y "notificaciones de esta tarea".
  @@index([taskId, type, createdAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ip         String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Agency {
  id           String            @id @default(cuid())
  name         String
  /// Slug legible para URLs admin (`/admin/agencies/acme`). Único global,
  /// sigue al nombre. Nullable: rows sin slug se resuelven por id.
  slug         String?           @unique
  updatedAt    DateTime          @default(now()) @updatedAt
  /// Soft-suspend por admin: si está seteado, todas las brands quedan en
  /// read-only y los members no pueden mutar. Se mantiene la data para
  /// poder revertir o auditar. Distinto de borrar (delete cascade).
  suspendedAt      DateTime?
  suspendedReason  String?
  /// Feature flags experimentales habilitadas para esta agency. Se
  /// resuelve via hasFeature(agencyId, "flag"). Lo que está acá sobrescribe
  /// los defaults del plan. Ej: { "beta_analytics": true, "white_label": false }.
  featureFlags     Json?
  /// Colores customizados de las columnas del Kanban de tareas. Shape:
  /// { todo: "slate", in_progress: "blue", review: "violet", done: "emerald" }.
  /// Si null o falta una key, usa el default hardcodeado.
  /// Valores válidos: slate, zinc, red, orange, amber, yellow, lime, emerald,
  /// teal, cyan, sky, blue, indigo, violet, fuchsia, pink, rose.
  taskStatusColors Json?
  /// Columnas del Kanban de tareas, customizables por agency. Reemplaza al
  /// set fijo todo/in_progress/review/done. Shape: array ordenado de
  /// { id, label, color, isDone }. Si null, se siembra desde los 4 defaults
  /// (y mergea taskStatusColors legacy para colores).
  taskColumns      Json?
  /// Branding white-label. Solo se aplica si la agency tiene el add-on
  /// `whiteLabelAddon` activo (o un plan que lo incluya como Agency).
  /// Si está vacío y el add-on activo, se muestra el branding default.
  wlBrandName       String?
  wlLogoUrl         String?
  /// Color de acento "principal" (botones, links no-gradient, ring focus).
  /// Si null, usamos el color violeta default.
  wlAccentColor     String?
  /// Colores del gradiente principal (`.brand-gradient` y `.brand-gradient-text`).
  /// Se override en runtime via `<style>` inyectado en el layout. Si null,
  /// usa el gradiente azul→violeta→rosa default.
  wlGradientFrom    String?
  wlGradientTo      String?
  /// Cómo mostrar la marca en el sidebar / headers:
  ///  - "logo_and_text" (default): logo chico + nombre del brand al lado
  ///  - "logo_only": logo grande, sin texto (ideal si tu logo ya tiene el
  ///    nombre integrado, como un wordmark)
  ///  - "text_only": solo el nombre, sin logo (cuando no hay logo subido o
  ///    se prefiere tipografía limpia)
  wlLogoMode        String?
  /// Altura del logo en px cuando modo = "logo_only". Range razonable 20-56.
  /// Default 32. En otros modos no aplica (el logo chico es fijo a 28).
  wlLogoHeight      Int?
  /// Alineación del header del sidebar: "left" | "center" | "right".
  /// Default "left" para logo_and_text y text_only, "center" para logo_only.
  wlHeaderAlign     String?
  createdAt    DateTime          @default(now())
  brands       Brand[]
  members      Membership[]
  invitations  TeamInvitation[]
  customRoles  Role[]
  subscription Subscription?
  tasks        Task[]
  taskTags     TaskTag[]
  taskTemplates TaskTemplate[]
}

/// Suscripción 1:1 con Agency. Define qué plan tiene activo, su estado de
/// facturación y add-ons. Lazy-created como "free / active" la primera vez
/// que se consulta para un agency que no tiene fila todavía.
/// Configuración global del sistema. Guardamos en este KV table cosas como la
/// master key de encriptación (para que el admin panel no necesite tocar env
/// vars en Vercel). Solo el código del servidor lee/escribe acá.
model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Idempotency log de webhooks externos (Wompi, Stripe, etc.). Cada vez
/// que recibimos un evento con `id` único, lo registramos. Si llega el
/// mismo `id` después (Wompi reintenta hasta 3 veces), lo ignoramos sin
/// re-procesar. Cubre el caso "Wompi reenvió APPROVED por timeout pero ya
/// marcamos invoice paid".
/// Comunicaciones masivas (broadcasts) que el admin envía a usuarios.
/// Cada broadcast guarda el snapshot de la audiencia, template, y el
/// progreso de envío (counts de enviados/fallidos).
model EmailBroadcast {
  id          String   @id @default(cuid())
  subject     String
  bodyHtml    String   @db.Text
  audience    String
  /// Estado: "draft" | "scheduled" | "sending" | "sent" | "failed"
  status      String   @default("draft")
  /// Si está seteado, el cron lo despacha cuando NOW() >= scheduledAt.
  /// Mientras tanto status="scheduled".
  scheduledAt DateTime?
  sentCount   Int      @default(0)
  failedCount Int      @default(0)
  totalCount  Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  sentAt      DateTime?
  errorMessage String?

  @@index([createdAt])
  @@index([status])
  @@index([scheduledAt])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  /// Provider: "wompi" | "stripe" | etc.
  provider    String
  /// ID del evento del provider — debe ser unique por provider.
  externalId  String
  /// Tipo del evento (ej. "transaction.updated"). Solo informativo.
  eventType   String?
  /// Estado de procesamiento: "ok" | "signature_invalid" | "error" | "deduped"
  /// Lo seteamos al final del handler (o al rechazar firma).
  status      String   @default("ok")
  /// Mensaje de error humano-legible si status != ok.
  errorMessage String?
  /// Payload completo recibido (raw JSON) para debugging y replay manual.
  /// Lo guardamos incluso cuando la firma es inválida — útil para detectar
  /// si hay configuración mala vs ataque.
  payload     Json?
  /// IP de origen (Wompi se sabe pero por si las dudas)
  ip          String?
  /// Cuándo lo procesamos (para detectar replays viejos si pasan +24h)
  receivedAt  DateTime @default(now())
  /// Retry queue: si status="error", el cron de retries va a intentarlo de
  /// nuevo con backoff exponencial. retryCount incrementa cada intento.
  /// nextRetryAt indica cuándo se puede reintentar (null = no más retries).
  retryCount   Int      @default(0)
  nextRetryAt  DateTime?

  @@unique([provider, externalId])
  @@index([receivedAt])
  @@index([provider, status, receivedAt])
  @@index([status, nextRetryAt])
}

/// Audit log genérico para acciones sensibles (cambio de role, billing,
/// integraciones, etc.). Compliance-friendly: cada operación que modifica
/// permisos o estado de pago debería loggear acá.
///
/// `actorUserId` puede ser null si la acción la disparó el sistema (cron, etc).
model AuditLog {
  id           String   @id @default(cuid())
  /// Categoría: "auth" | "billing" | "integrations" | "admin" | "team"
  category     String
  /// Acción específica: "role.changed", "subscription.canceled", etc.
  action       String
  actorUserId  String?
  actorEmail   String?
  /// Identificador del recurso afectado (ej. agencyId, userId, etc).
  targetId     String?
  /// JSON con detalles adicionales (antes/después, motivo, etc).
  metadata     Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([category, createdAt])
  @@index([actorUserId])
  @@index([targetId])
}

/// Audit log de rotaciones de master key. Cada vez que un admin rota,
/// guardamos quién + cuándo + cuántas integraciones se re-encriptaron.
/// Útil para compliance (SOC 2, ISO 27001) y debugging.
model KeyRotationLog {
  id                String   @id @default(cuid())
  rotatedByUserId   String
  rotatedByEmail    String
  /// Cantidad de IntegrationConfig que se re-encriptaron en esta rotación.
  configsReEncrypted Int     @default(0)
  /// Si la rotación pidió un motivo (ej. "sospecha de fuga", "rotación de
  /// rutina"), lo guardamos para audit.
  reason            String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
}

/// Configuración de integraciones externas (pasarelas de pago, providers de
/// email, AI, etc.) gestionadas desde el admin panel. Las llaves privadas
/// se guardan ENCRIPTADAS con AES-256-GCM (master key en env). El campo
/// publicMeta es JSON con info no-secreta para mostrar en UI (ej. últimos
/// 4 dígitos de la public key, cuándo fue actualizado, etc.).
model IntegrationConfig {
  id              String   @id @default(cuid())
  /// Categoría: "payment" | "notification" | "ai" | "storage" | etc.
  category        String
  /// Provider específico: "wompi" | "stripe" | "paddle" | "slack" | etc.
  provider        String
  /// "sandbox" | "production"
  environment     String   @default("sandbox")
  /// JSON encriptado con las llaves privadas y secretos. Nunca leer raw.
  /// Decrypt vía lib/encryption.ts.
  encryptedConfig String   @db.Text
  /// JSON con info pública mostrable: nombres de cuenta, prefijos de keys,
  /// último uso, etc. Para que el admin vea estado sin exponer secretos.
  publicMeta      Json?
  /// Si está habilitado para uso. Inactivo = la app ignora esta config y
  /// usa otra activa (o falla con "no payment provider configured").
  enabled         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// Solo una config activa por provider+environment a la vez.
  @@unique([provider, environment])
  @@index([category, enabled])
}

model Subscription {
  id                 String          @id @default(cuid())
  agencyId           String          @unique
  agency             Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  /// "free" | "pro" | "agency". Solo se actualiza cuando el webhook
  /// de Wompi confirma el pago. NUNCA tocar este campo desde el
  /// checkout endpoint — usar pendingPlan en su lugar.
  plan               String          @default("free")
  /// "trialing" | "active" | "past_due" | "canceled" | "expired"
  status             String          @default("active")
  /// "monthly" | "yearly". Idem plan — solo el webhook lo modifica.
  billingCycle       String          @default("monthly")

  /// Plan que el user inició checkout pero todavía no pagó. Cuando el
  /// webhook confirma el pago, movemos pendingPlan → plan y
  /// limpiamos esto. Si el user nunca paga, queda hasta que arranque
  /// otro checkout (sobreescribe).
  pendingPlan        String?
  pendingBillingCycle String?

  /// Fin del trial (si está en trialing). Pasado este momento, el cron
  /// downgradea a free si no se cargó tarjeta.
  trialEndsAt        DateTime?

  /// Período actual del cobro pagado.
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  /// Cuándo le toca el próximo cobro (usado por el cron diario).
  nextChargeAt       DateTime?

  /// Cancelación: si cancelAtPeriodEnd=true, mantenemos plan hasta currentPeriodEnd.
  canceledAt         DateTime?
  cancelAtPeriodEnd  Boolean         @default(false)

  /// Tracking de emails de trial-ending ya enviados. El cron diario los
  /// usa para evitar duplicar (ej. si trialEndsAt es en 3d, mandamos uno;
  /// al día siguiente no queremos remandar el de "3 días"). Se resetea al
  /// renovar / pasar a paid.
  trialEmail3dSentAt  DateTime?
  trialEmail1dSentAt  DateTime?
  trialEndedEmailSentAt DateTime?

  /// Add-ons que suman a los límites del plan base.
  extraBrands        Int             @default(0)
  extraSeats         Int             @default(0)
  whiteLabelAddon    Boolean         @default(false)
  /// Saldo a favor acumulado en centavos COP. Lo descuenta el cron de
  /// billing en el próximo cobro mensual. Lo cargan los pagos de
  /// validación de método de pago (ej: $1.000 que paga el user para
  /// guardar la tarjeta queda como crédito acá, se descuenta de su
  /// siguiente factura).
  creditCents        Int             @default(0)
  /// Cuándo el user aceptó una oferta de retención (cupón anti-churn).
  /// Limita el offer a 1 vez por año por agency para evitar abuso.
  retentionOfferAcceptedAt DateTime?

  /// Customer ID en Wompi (para reusar entre cobros). Opcional porque
  /// algunos plans (free/trialing) nunca crean customer.
  wompiCustomerId    String?

  /// Cuándo entró en past_due (primer cobro fallido). Se usa como ancla
  /// para el dunning escalonado (día 1, 3, 7). Se limpia al volver a active.
  pastDueSinceAt     DateTime?
  /// Último recordatorio de pago fallido enviado. Evita duplicar el mismo
  /// recordatorio dentro del mismo "stage" (1d/3d/7d).
  lastDunningSentAt  DateTime?
  /// Stage del último dunning mandado ("d1" | "d3" | "d7"). El cron solo
  /// manda el siguiente si todavía no se mandó este stage.
  lastDunningStage   String?

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  paymentMethods     PaymentMethod[]
  invoices           Invoice[]

  @@index([nextChargeAt, status])
  @@index([trialEndsAt, status])
}

/// Token de tarjeta vault de Wompi. Guardamos el sourceId (no la tarjeta
/// real) y metadata para mostrar al usuario "Visa terminada en 4242".
model PaymentMethod {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// Token de payment_source en Wompi. Null mientras el flujo NEQUI está
  /// esperando que el user apruebe el push: en ese estado tenemos
  /// nequiTokenId pero todavía no creamos el source. Una vez que el token
  /// se aprueba, /check crea el source y guarda el id acá.
  wompiSourceId  String?      @unique
  /// Solo para NEQUI: id del /tokens/nequi (tok_nequi_...) que el user
  /// debe aprobar via push. Después de aprobado, /check usa este token
  /// para crear el payment_source.
  nequiTokenId   String?
  /// Tipo: "CARD" | "PSE" | "NEQUI" | etc. Solo CARD y NEQUI soportan recurrente.
  type           String       @default("CARD")

  /// Display info (4 últimos dígitos, marca, vencimiento).
  brand          String?
  last4          String?
  expMonth       Int?
  expYear        Int?
  holderName     String?

  isDefault      Boolean      @default(true)

  /// Wompi environment con que se creó el token: "sandbox" | "production".
  /// Wompi tiene universos paralelos — un token de sandbox no funciona
  /// en production y viceversa. El cron salta tokens que no matchean
  /// el environment actual (configurado en /admin/integrations) en vez
  /// de intentar cobrar y fallar con error críptico.
  ///
  /// Null para rows legacy creadas antes de este campo (asumimos sandbox
  /// porque era el default histórico).
  environment    String?

  /// Estado del payment_source en Wompi: "AVAILABLE" (listo para cobrar),
  /// "PENDING" (esperando aprobación del user en su app Nequi), "DECLINED"
  /// (rechazado), "ERROR". Para CARD típicamente nace AVAILABLE inmediato.
  /// Para NEQUI nace PENDING hasta que el user aprueba el push.
  ///
  /// Null en rows legacy creadas antes de este campo (asumimos AVAILABLE
  /// por compat).
  wompiStatus    String?
  /// Última vez que verificamos el status contra Wompi. Para evitar
  /// pollings excesivos / re-verificar muy seguido.
  wompiStatusCheckedAt DateTime?

  createdAt      DateTime     @default(now())

  @@index([subscriptionId])
}

/// Cada cobro intentado/exitoso/fallido. Permite ver historial de facturación
/// y saber qué cobros fallaron para reintentar.
model Invoice {
  id                 String       @id @default(cuid())
  subscriptionId     String
  subscription       Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// Número de factura legible para el cliente (formato MF-2026-000001).
  /// Se asigna AL pasar a paid (no al crear pending) para evitar gaps en
  /// la numeración por intentos fallidos.
  invoiceNumber      String?      @unique

  /// Monto en CENTAVOS de la moneda (COP × 100). Usamos int para evitar floats.
  /// `amount` = total final cobrado. `subtotal` y `taxAmount` se llenan al
  /// confirmar pago (subtotal = amount/1.19 si IVA, taxAmount = amount - subtotal).
  amount             Int
  subtotal           Int?
  taxAmount          Int?
  taxRate            Float?       @default(0) // 0.19 si IVA aplicable
  currency           String       @default("COP")

  /// "pending" | "paid" | "failed" | "refunded"
  status             String       @default("pending")

  /// IDs de Wompi para tracear el cobro.
  /// - wompiPaymentLinkId: el `data.id` que Wompi devuelve al crear el link
  ///   (ej. "test_0OMpbr"). El webhook trae este id en transaction.payment_link_id
  ///   y lo usamos para mapear → invoice (más confiable que la reference, que
  ///   Wompi auto-genera para cada transacción y no podemos predecir).
  /// - wompiTransactionId: el id de la transacción real (lo seteamos en el
  ///   webhook al confirmar pago).
  /// - wompiReference: nuestra referencia interna (mf_<sub>_<ts>_<rand>),
  ///   sirve para que el user vuelva a /billing/return con su pago.
  wompiPaymentLinkId String?      @unique
  wompiTransactionId String?      @unique
  wompiReference     String?      @unique

  /// Período que cubre este cobro (mensual o anual).
  periodStart        DateTime?
  periodEnd          DateTime?

  description        String?

  /// Si este invoice es por un add-on (no un cobro de plan), guardamos
  /// qué add-on y cuántas unidades. El webhook usa estos campos al
  /// confirmar el pago para incrementar Subscription.extraBrands etc.
  /// Null cuando el invoice corresponde a un cobro de plan normal.
  addonType          String?
  addonQuantity      Int?

  /// Cupón aplicado (si el user ingresó código de descuento en checkout).
  /// `couponCode` se guarda denormalizado para mostrarlo en historial.
  /// `discountCents` es el descuento aplicado (siempre positivo). `amount`
  /// arriba YA tiene el descuento aplicado (es el final que cobramos).
  couponCode         String?
  discountCents      Int?

  paidAt             DateTime?
  failedAt           DateTime?
  /// Si la transacción fue anulada (típico para validaciones de método
  /// de pago donde no queremos cobrar realmente). Status="refunded".
  refundedAt         DateTime?
  failedReason       String?

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([subscriptionId, createdAt])
}

/// Códigos de descuento para promos. Los crea el admin del sistema desde
/// /admin/coupons. El user los aplica en el checkout antes de pagar.
///
/// Tipos de descuento:
///  - percentOff (0-100) → porcentaje del precio
///  - amountOffCents → descuento fijo en centavos COP
///  - Exactamente UNO de los dos debe estar set (validado en el endpoint)
///
/// Restricciones:
///  - validFrom / validUntil → ventana de tiempo de validez
///  - maxRedemptions → cap total de usos (null = ilimitado)
///  - applicablePlans → si tiene valores, solo aplica a esos plans (ej.
///    ["pro"] = solo válido para upgrade a Pro). Vacío = todos.
///  - applicableCycles → idem para "monthly"/"yearly". Vacío = ambos.
///  - oncePerAgency → si true, una agency solo lo puede usar 1 vez (chequeado
///    via CouponRedemption.agencyId al validar).
model Coupon {
  id               String              @id @default(cuid())
  /// Código case-insensitive que el user ingresa (lo normalizamos a UPPERCASE)
  code             String              @unique
  description      String?
  percentOff       Int?
  amountOffCents   Int?
  validFrom        DateTime            @default(now())
  validUntil       DateTime?
  maxRedemptions   Int?
  redemptionCount  Int                 @default(0)
  applicablePlans  String[]            @default([])
  applicableCycles String[]            @default([])
  oncePerAgency    Boolean             @default(true)
  active           Boolean             @default(true)
  createdAt        DateTime            @default(now())
  createdByUserId  String?
  redemptions      CouponRedemption[]

  @@index([code])
  @@index([active, validUntil])
}

/// Tabla de uso: 1 row por invoice que aplicó cupón. Permite:
///  - Contar redenciones por cupón (uso real + atómico)
///  - Verificar "oncePerAgency" buscando si esta agency ya redimió este cupón
///  - Historial de cuánto se ahorró cada cliente
///
/// SEGURIDAD: la validación de `oncePerAgency` y `maxRedemptions` se hace
/// dentro de una transacción Serializable + UPDATE condicional en
/// Coupon.redemptionCount (ver lib/coupons.ts:recordRedemption). Eso
/// previene que dos requests paralelos rebasen los caps.
model CouponRedemption {
  id               String   @id @default(cuid())
  couponId         String
  coupon           Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  agencyId         String
  invoiceId        String   @unique
  amountSavedCents Int
  redeemedAt       DateTime @default(now())

  @@index([couponId])
  @@index([agencyId])
}

model TeamInvitation {
  id        String    @id @default(cuid())
  agencyId  String
  email     String
  role      String    @default("editor")
  token     String    @unique @default(cuid())
  /// Brand IDs a las que dar acceso al aceptar. Si está vacío → membership
  /// agency-wide (caso típico para team members). Si tiene IDs → se crea
  /// una membership por brand (caso típico para invitar clientes a su(s)
  /// marca(s) específica(s)).
  brandIds  String[]  @default([])
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime  @default(now())
  agency    Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
}

model Membership {
  id       String  @id @default(cuid())
  userId   String
  agencyId String
  brandId  String?
  /// Slug del rol. Puede ser un system role hardcodeado en
  /// src/lib/permissions.ts (owner, manager, community_manager, designer,
  /// copywriter, strategist, client) o el slug de un Role custom de la
  /// agency. Para resolver permisos, usar hasPermission() del lib.
  role     String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency   Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  brand    Brand?  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  // El @@unique de abajo ya cubre queries por (userId) y (userId, agencyId)
  // como prefijo. Estos dos cubren el reverso: listar miembros de una agencia
  // (team, notifs) y clients de una marca — Postgres NO indexa FKs solo.
  @@index([agencyId])
  @@index([brandId])
  @@unique([userId, agencyId, brandId])
}

/// Roles custom definidos por una agency. Los system roles NO viven aquí
/// (están hardcodeados en src/lib/permissions.ts). El slug se genera del
/// name y debe ser único por agency. permissions es un array de strings
/// que matchean el catálogo de PERMISSIONS del lib.
model Role {
  id          String   @id @default(cuid())
  agencyId    String
  name        String
  slug        String
  description String?
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, slug])
  @@index([agencyId])
}

model Brand {
  id          String       @id @default(cuid())
  agencyId    String
  name        String
  /// Slug legible para la URL (`/brands/acme`). Único global. Sigue al
  /// nombre al renombrar. Nullable para back-compat: rows sin slug se
  /// resuelven por id (ver lib/slugs.ts resolveBrandRef).
  slug        String?      @unique
  handle      String?
  inviteCode  String       @unique @default(cuid())
  publicToken String?      @unique
  widgetToken String?      @unique
  logoUrl     String?
  color       String?
  bio         String?
  // Breakpoints responsive Elementor-style. JSON con keys:
  // mobilePortrait, tabletPortrait, tabletLandscape, laptop, widescreen.
  // Cada uno es el upper-bound (px) de esa categoría. null = usar defaults.
  breakpoints Json?
  /// Marca pausada por exceder el límite del plan. Cuando la agencia
  /// downgradea a un plan con menos brands de las que tiene, las
  /// excedentes se marcan con lockedAt en vez de borrarse — así no se
  /// pierde data y se puede reactivar con upgrade. Las locked son
  /// read-only (no posts nuevos, no edits, comments visibles).
  lockedAt    DateTime?
  /// Credenciales de publicación de Instagram (Meta Graph API).
  /// igUserId = Instagram Business Account ID (NO @username)
  /// Long-lived user token con permisos pages_show_list, instagram_basic,
  /// instagram_content_publish, business_management. Lo guardamos por brand
  /// para que cada cliente conecte su cuenta.
  ///
  /// SIEMPRE leer/escribir via lib/instagram-token.ts (encripta/desencripta
  /// con la master key del proyecto). igAccessToken (plain) queda solo para
  /// rows legacy hasta que el endpoint de migración las migre a Enc; después
  /// se va a deprecar.
  igUserId           String?
  igAccessToken      String?
  igAccessTokenEnc   String?
  igTokenRefreshedAt DateTime?
  /// Estado de la conexión: null = no conectada; "ok" = funciona; "needs_reconnect"
  /// = el cron refresh detectó token caducado y necesita que el user reconecte.
  igConnectionStatus String?
  createdAt   DateTime     @default(now())
  agency      Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  posts        Post[]
  memberships  Membership[]
  hashtagSets  HashtagSet[]
  templates    PostTemplate[]
  tasks        Task[]

  // Listar marcas activas de una agency (uso constante: brands, KPIs, sidebar).
  @@index([agencyId, lockedAt])
}

model HashtagSet {
  id        String   @id @default(cuid())
  brandId   String
  name      String
  tags      String   @default("") // hashtags separados por espacio
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

model PostView {
  id           String   @id @default(cuid())
  userId       String
  postId       String
  lastViewedAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model Presence {
  id        String   @id @default(cuid())
  userId    String
  /// Presencia en un post (aprobación) O en una tarea — uno de los dos.
  postId    String?
  taskId    String?
  updatedAt DateTime @updatedAt

  @@unique([userId, postId])
  @@unique([userId, taskId])
  @@index([postId, updatedAt])
  @@index([taskId, updatedAt])
}

model PostTemplate {
  id        String   @id @default(cuid())
  brandId   String
  name      String
  caption   String   @default("")
  platform  String   @default("instagram")
  postType  String   @default("feed")
  /// Si true, esta plantilla es visible para TODAS las brands de la
  /// agency, no solo la suya. Útil cuando una agencia quiere mantener
  /// una biblioteca común de plantillas reutilizables. El brandId sigue
  /// señalando la brand "dueña" / autora.
  sharedAgencyWide Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([brandId, sharedAgencyWide])
}

model Post {
  id          String     @id @default(cuid())
  brandId     String
  authorId    String
  /// Número legible y secuencial POR marca para la URL
  /// (`/brands/acme/posts/42`). Único dentro de la marca. Nullable para
  /// back-compat: posts sin número se resuelven por id.
  number      Int?
  title       String?
  caption     String     @default("")
  imageUrl    String?
  platform    String     @default("instagram")
  postType    String     @default("feed")
  assetType   String     @default("social_post") // social_post | web_design | graphic | video | branding | other
  sourceUrl   String?    // URL externa: web_design embebida en iframe o video (YouTube/Vimeo)
  scheduledAt  DateTime?
  publishedAt  DateTime?
  publishedUrl String?
  publishError String?
  /// IG Media ID retornado por Meta al publicar — usado para llamar a
  /// /v21.0/{media-id}/insights y traer likes/comments/reach.
  igMediaId    String?
  /// Insights cacheados (likes, comments, reach, impressions, etc.) JSON.
  /// Refrescados periódicamente con /api/posts/[id]/insights.
  insights     Json?
  /// Timestamp del último fetch de insights (para evitar spam de la API).
  insightsRefreshedAt DateTime?
  deletedAt   DateTime?
  position    Int        @default(0)
  status      String     @default("draft")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  brand       Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  comments    Comment[]
  approvals   Approval[]
  images      PostImage[]
  versions    PostVersion[]
  activities  Activity[]
  tasks       Task[]

  // Queries calientes: tablero/lista por marca (excluyendo papelera + por
  // estado) y el cron de publicación (posts programados vencidos).
  @@index([brandId, deletedAt, status])
  @@index([status, scheduledAt])
  // Número legible único por marca (para URLs /brands/<slug>/posts/<n>).
  @@unique([brandId, number])
}

model Activity {
  id        String   @id @default(cuid())
  postId    String
  userId    String?
  type      String
  meta      String   @default("{}")
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
}

model PostVersion {
  id          String   @id @default(cuid())
  postId      String
  version     Int
  caption     String   @default("")
  imagesJson  String   @default("[]") // JSON array of urls (snapshot)
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, version])
}

model PostImage {
  id        String   @id @default(cuid())
  postId    String
  url       String
  position  Int      @default(0)
  mime      String?
  name      String?
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Comment {
  id            String    @id @default(cuid())
  postId        String
  userId        String
  body          String
  // Anclaje espacial para imágenes (% del ancho/alto). Null para
  // comentarios sin posición, replies, o anclados a video.
  x             Float?
  y             Float?
  // Anclaje temporal para videos. Segundos desde el inicio (decimal).
  // Null si el comentario no se hizo sobre un video con timestamp.
  videoTime     Float?
  parentId      String?
  resolved      Boolean   @default(false)
  // Comentario interno del equipo: el cliente NO lo ve. Por default, si el post
  // está en draft y la agencia comenta, queda como interno.
  internal      Boolean   @default(false)
  // Miembro del equipo al que se le asignó este comentario
  assignedToId  String?
  attachmentUrl String?
  attachmentName String?
  attachmentMime String?
  // Contexto del widget de feedback (cuando un comment viene del widget en sitio)
  pageUrl       String?
  selector      String?
  viewportW     Int?
  viewportH     Int?
  scrollY       Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation("CommentAuthor", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo User?    @relation("CommentAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([assignedToId])
  // Cargar los comentarios de un post ordenados por fecha (uso constante).
  @@index([postId, createdAt])
}

model WidgetPing {
  id         String   @id @default(cuid())
  brandId    String
  url        String
  origin     String
  userAgent  String?
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  hitCount   Int      @default(1)

  @@unique([brandId, url])
  @@index([brandId, lastSeenAt])
}

model Approval {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  decision  String
  note      String?
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Última aprobación de un post (findFirst postId orderBy createdAt desc) —
  // se consulta en cada apertura de post y en reportes.
  @@index([postId, createdAt])
}

/// Tareas internas del equipo de la agencia — Kanban-style con drag-and-drop
/// entre columnas (todo / in_progress / review / done). Pueden ser:
///   - de agencia (brandId=null): ops, admin, sin marca puntual
///   - de marca (brandId=X): atadas a una marca específica
///   - linkeadas a un post (postId=X, brandId siempre obligado entonces):
///     contexto rápido tipo "ajustar caption del post X"
///
/// CLIENTS NUNCA VEN TAREAS — son internas del equipo agency. Las queries
/// SIEMPRE filtran por agencyId del user actual.
model Task {
  id          String    @id @default(cuid())
  agencyId    String
  brandId     String?
  postId      String?

  title       String    @db.VarChar(200)
  description String?   @db.Text

  /// status del kanban: "todo" | "in_progress" | "review" | "done"
  status      String    @default("todo")
  /// "low" | "normal" | "high" | "urgent"
  priority    String    @default("normal")

  assigneeId  String?
  /// Quién la creó. NUNCA se borra (no cascade) — si el creator deja la
  /// agencia, la tarea sobrevive con creatorId apuntando a un user que ya
  /// no pertenece (se filtra a runtime).
  creatorId   String

  dueDate     DateTime?
  /// Recurrencia: al COMPLETAR la tarea se crea automáticamente la próxima
  /// ocurrencia (clon con dueDate corrido). Valores: "daily" | "weekly" |
  /// "biweekly" | "monthly". Null = tarea normal sin repetición.
  recurrence  String?
  /// Orden dentro de su columna. Drag-and-drop reescribe esto en bulk.
  /// Floats permiten insertar entre dos cards sin reescribir todos
  /// (ej. mid = (prev.pos + next.pos) / 2). Pero usamos Int por simpleza
  /// y reescribimos en bulk con paso 1000.
  position    Int       @default(0)
  completedAt DateTime?
  /// Soft delete — cuando != null la tarea está en la papelera. Las
  /// queries de listado/kanban filtran por deletedAt:null por default.
  /// Restaurar = set deletedAt a null. Hard delete real desde la papelera.
  deletedAt   DateTime?
  deletedById String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  agency      Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  brand       Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  post        Post?     @relation(fields: [postId], references: [id], onDelete: SetNull)
  /// Legacy single assignee — mantener para compat con queries existentes.
  /// El código nuevo usa `assignees` (M2M).
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator     User      @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  /// NUEVO: lista de assignees (1 o más users por tarea).
  assignees   User[]    @relation("TaskAssignees")
  subtasks    Subtask[]
  tags        TaskTag[] @relation("TaskTagsOnTask")
  comments    TaskComment[]  @relation("TaskComments")
  activities  TaskActivity[] @relation("TaskActivities")
  attachments TaskAttachment[]

  @@index([agencyId, status])
  @@index([assigneeId, status])
  @@index([brandId])
  @@index([dueDate])
  // Tablero principal (agencyId + sin papelera) y poll SSE (updatedAt > cursor).
  @@index([agencyId, deletedAt])
  @@index([agencyId, updatedAt])
}

/// Comentarios en tareas — discusión async sobre cada tarea. Markdown-lite
/// soportado en el body (igual que Description). Solo internal team puede
/// comentar (clients NUNCA ven tareas, así que no aplica).
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  body      String   @db.Text
  editedAt  DateTime?
  createdAt DateTime @default(now())

  task      Task     @relation("TaskComments", fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation("TaskCommentAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

/// Activity log de cambios en una tarea — historial auditable que se
/// renderiza como timeline en el drawer ("X cambió status de Y a Z").
/// Tipos: status_changed, assignee_added, assignee_removed, priority_changed,
///        brand_changed, due_changed, title_changed, tag_added, tag_removed,
///        comment_added, completed, reopened.
model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  userId    String?
  type      String
  /// JSON con el contexto del cambio. Ej:
  /// status_changed: { from: "todo", to: "in_progress" }
  /// assignee_added: { userId: "abc", userName: "Juan" }
  /// priority_changed: { from: "normal", to: "urgent" }
  meta      Json?
  createdAt DateTime @default(now())

  task      Task     @relation("TaskActivities", fields: [taskId], references: [id], onDelete: Cascade)
  user      User?    @relation("TaskActivityActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

/// Etiquetas/labels de tareas — clasificadores visuales además del estado.
/// Ej: "Bug", "Cliente VIP", "Diseño", "Bloqueado". Scope por agency
/// (cada equipo crea las suyas). Color hex para diferenciarlas visualmente.
model TaskTag {
  id        String   @id @default(cuid())
  agencyId  String
  name      String   @db.VarChar(40)
  /// Hex color: #RRGGBB. Default zinc-500 si no se pasa.
  color     String   @default("#71717a")
  createdAt DateTime @default(now())

  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  tasks     Task[]   @relation("TaskTagsOnTask")

  /// Evita duplicados case-insensitive — el endpoint debe normalizar a
  /// lowercase antes de validar / crear.
  @@unique([agencyId, name])
  @@index([agencyId])
}

/// Plantilla de proyecto: set de tareas predefinidas que la agencia aplica a
/// una marca en 1 clic (ej. "Onboarding cliente nuevo" → 8 tareas con plazos
/// relativos). `items` es un array JSON:
///   [{ title, priority?, dueOffsetDays?, subtasks?: string[] }]
/// dueOffsetDays = días desde el momento de aplicar (null = sin fecha).
model TaskTemplate {
  id        String   @id @default(cuid())
  agencyId  String
  name      String   @db.VarChar(80)
  items     Json
  createdAt DateTime @default(now())
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
}

/// Archivo adjunto de una tarea (brief, diseño de referencia, etc.). El
/// archivo vive en R2 (subido por /api/upload); acá guardamos la URL.
model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String?
  url       String
  name      String?
  mime      String?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

/// Checklist dentro de una tarea (subtareas tipo Trello). Se marcan
/// completadas con un click — útiles para descomponer una tarea grande.
model Subtask {
  id        String   @id @default(cuid())
  taskId    String
  title     String   @db.VarChar(200)
  completed Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}
